# Used by compose.yaml (and by a development checkout). Production installs use keystone.properties.
KEYSTONE_PORTAL_URL=
KEYSTONE_PORTAL_CLIENT_ID=keystone
KEYSTONE_SERVER_TRUST_PROXY=false
# 32 random bytes, base64 (openssl rand -base64 32). Leave unset to let Keystone generate one
# into its home on first start. BACK IT UP: without it no stored secret can be decrypted.
KEYSTONE_VAULT_MASTER_KEY=
# MySQL with `docker compose --profile mysql up -d`:
# MYSQL_PASSWORD=change-me
# KEYSTONE_STORAGE_DATABASE_URL=mysql://keystone:change-me@mysql:3306/keystone
